{
  "name": "gemini",
  "description": "Google Gemini CLI — gemini.md, .gemini/settings.json ztk hook, and .gemini/skills mirror",
  "files": [
    {
      "src": "gemini.md",
      "dst": "gemini.md",
      "merge_policy": "overwrite"
    },
    {
      "src": ".gemini/settings.json",
      "dst": ".gemini/settings.json",
      "merge_policy": "merge_or_alert"
    }
  ],
  "skills_link": {
    "target": ".agent/skills",
    "dst": ".gemini/skills",
    "fallback": "rsync_with_delete"
  }
}
